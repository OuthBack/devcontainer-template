// .devcontainer/devcontainer.json
{
  "image": "debian:stable-slim",
  "mounts": [
    "source=${env:HOME}/.gitconfig,target=/root/.gitconfig,type=bind,consistency=cached,readonly=false",
    "source=${env:HOME}/.ssh,target=/tmp/host-ssh,type=bind,consistency=cached,readonly=true",
    "source=${localWorkspaceFolder}/.git,target=${containerWorkspaceFolder}/.git,type=bind,consistency=cached",
    "source=${env:XDG_RUNTIME_DIR}/${env:WAYLAND_DISPLAY},target=${env:XDG_RUNTIME_DIR}/${env:WAYLAND_DISPLAY},type=bind,consistency=cached"
  ],
  "containerEnv": {
    "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
    "XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
    "TERM": "xterm-256color",
    "COLORTERM": "truecolor",
    "NO_BROWSER": "true",
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}"
  },
  "postCreateCommand": [
    "/bin/sh",
    "-c",
    "{ echo \"--- New Run: $(date) ---\"; /bin/sh ./.devcontainer/install.sh; } >> ./.devcontainer/postcreate.log 2>&1"
  ],
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/node:1.1.2": {
      "imageVariant": 24
    }
  },
  // Rede do host: o container compartilha o namespace de rede da maquina.
  // Consequencias:
  //   1. A infra (postgres, redis, dynamodb, mysql) e alcancada por
  //      localhost:<porta publicada>, NUNCA por nome de container.
  //   2. As portas do app ja aparecem no host; nao existe forwardPorts,
  //      appPort nem tunel reverso.
  //   3. Colisao de porta entre devcontainers e real: use `whoport <porta>`
  //      no host para descobrir o ocupante.
  // --dns nao pode coexistir com --network=host; o container usa o
  // /etc/resolv.conf do host.
  "runArgs": ["--network=host"]
}
